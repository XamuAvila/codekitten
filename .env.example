# ─── Kitten v3 ───────────────────────────────────────────────────────────────
# Copy to .env and fill in. The .env file is loaded by:
#   - vitest (tests) via vitest.setup.ts → process.loadEnvFile()
#   - NOT loaded by the apps themselves — export vars in your shell for
#     manual runs, or set them in the minikube setup / compose env.

# ─── GitHub ─────────────────────────────────────────────────────────────────
# Token for cloning repos + GitHub PR API (clone, PR files, reviews, comments).
# Fed into the K8s Secret `kitten-github-token` by scripts/minikube-setup.sh.
GITHUB_TOKEN=

# ─── LLM providers (v3 multi-vendor) ────────────────────────────────────────
# One Secret `kitten-llm-keys` holds all three; the Pod picks the key by the
# repo's base_url (factory: anthropic→ANTHROPIC_API_KEY,
# deepseek→DEEPSEEK_API_KEY, openai→OPENAI_API_KEY).
#
# Default config ships DeepSeek (provider: anthropic + deepseek base_url) —
# that's the one you need first.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Dispatcher ──────────────────────────────────────────────────────────────
# Redis connection (BullMQ removed in v2 — status + pub/sub only).
REDIS_URL=redis://localhost:6379
PORT=3001

# K8s Pod orchestration
K8S_NAMESPACE=kitten
REVIEWER_IMAGE=kitten-reviewer:latest
POD_IDLE_TIMEOUT_MS=600000


MONGODB_URI=mongodb://localhost:27017/kitten
VOYAGE_API_KEY=AL....
